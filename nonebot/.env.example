# ---------- CaiBotLite (NoneBot 侧) ----------
# 与 TShock 端 CaiBotLite.json -> OneBot -> 通讯密钥 一致
CAIBOTLITE__SECRET=0123456789abcdef

# auto  : 同时监听并主动连接, 谁先连上用谁(默认, 跨网络首选)
# client: 只主动连 TShock            (TShock 有公网地址时用)
# server: 只监听, 让 TShock 反连      (机器人有公网地址时用)
# http  : HTTP 推送请求, 应答走 WebSocket
CAIBOTLITE__MODE=auto
# client / auto 模式下 TShock 的地址; TShock 没有公网地址时留空即可
CAIBOTLITE__SERVER_URL=ws://127.0.0.1:17779/onebot/v11/ws

# server / auto 模式下监听地址
# TShock 端 OneBot.机器人地址 填 ws://这里的IP:8080/caibotlite
CAIBOTLITE__LISTEN_HOST=0.0.0.0
CAIBOTLITE__LISTEN_PORT=8080

# 服务器主动发来的数据包(未指定回送目标时)默认发到哪个群
CAIBOTLITE__DEFAULT_GROUP=123456789
# 允许使用机器人的群(留空=不限制)
CAIBOTLITE__GROUPS=[]
# 机器人管理员 QQ。只有他们能用 commands.json 里"权限": "botadmin" 的指令,
# 以及 /泰拉 执行 中不在"开放指令"名单(time/clear/wind/worldevent)里的那些。
# 群管理身份不算, 群主也不行。权限不足时机器人只回"无权限"两个字。
CAIBOTLITE__ADMINS=[111111111]
CAIBOTLITE__SUPERUSERS=[]

CAIBOTLITE__RANK_LIMIT=10
CAIBOTLITE__DEBUG=false

# 指令表: 决定机器人支持哪些指令、哪些对所有人开放、帮助里显示什么。
# 默认读插件目录下的 commands.json; 想换成自己的一份就填绝对路径。
# CAIBOTLITE__COMMANDS_PATH=/app/plugins/nonebot_plugin_caibotlite/commands.json

# 所有指令都要写成 /泰拉 xxx, roots 是可以用的根指令名
# CAIBOTLITE__PREFIX=["","/","。"]
# CAIBOTLITE__ROOTS=["泰拉","tl"]

# /泰拉 执行 默认放行 time / clear / wind / worldevent 给所有人, 名单在
# commands.json 的"开放指令"里(帮助里会自动列出来)。名单外的指令需要机器人管理员。
#
# 真正决定"服务器允许执行什么"的是 TShock 端 CaiBotLite.json -> 允许远程执行的指令,
# 那边才是安全边界(远程执行跑在固定超管身份上)。机器人会在启动和每次连上时拉取
# 服务端真实的名单, 在帮助里如实显示, 并检查上面的"开放指令"是不是它的子集——
# 要放行新指令请改 TShock 端, 游戏里 /cbl onebot exec 查看, exec + <指令> 放行。

# 探测 TShock 下载链接是否可达(map/存档的链接打不开时会自动改用 base64 内联)
CAIBOTLITE__PROBE_TIMEOUT=5
CAIBOTLITE__PROBE_CACHE=300
